SIM ?= icarus
TOPLEVEL_LANG ?= verilog

# Resolve the repo root even when running make from verilog/tb
PROJECT_ROOT ?= $(abspath ../..)

# 1. Update VERILOG_SOURCES to point to the new Caravel wrapper, the 64x64 core, and the 1T1R arrays
VERILOG_SOURCES = $(PROJECT_ROOT)/verilog/rtl/defines.v \
                  $(PROJECT_ROOT)/verilog/rtl/user_project_wrapper.v \
                  $(PROJECT_ROOT)/verilog/rtl/neuron_core/hdl/nvm_neuron_core_64x64.v \
                  $(PROJECT_ROOT)/verilog/tb/hdl/nvm_core_decoder.v \
                  $(PROJECT_ROOT)/verilog/tb/hdl/nvm_neuron_block.v \
                  $(PROJECT_ROOT)/verilog/tb/hdl/nvm_neuron_spike_out.v \
                  $(PROJECT_ROOT)/verilog/rtl/neuron_core/hdl/reram_1t1r_snn_array_32x32.v \
                  $(PROJECT_ROOT)/verilog/rtl/neuron_core/hdl/reram_1t1r_snn_neuron.v

# 2. Set the TOPLEVEL to the wrapper updated in Step 1
TOPLEVEL = user_project_wrapper

# 3. Point to your Python test script execution module
MODULE = neuron_network_test

include $(shell cocotb-config --makefiles)/Makefile.sim